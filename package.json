{
  "name": "blooio-mcp",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy --env production",
    "plugin:zip": "rm -f blooio-plugin.zip && cd plugin && zip -qr ../blooio-plugin.zip . -x '.*'",
    "start": "wrangler dev",
    "sync-spec": "node scripts/sync-spec.mjs",
    "test": "node --test 'test/**/*.test.js'"
  },
  "dependencies": {
    "hono": "^4.12.23"
  },
  "devDependencies": {
    "wrangler": "^4.99.0"
  }
}
